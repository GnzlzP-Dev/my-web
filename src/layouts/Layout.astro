---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import GlobalStyles from "../components/GlobalStyles.astro";
import SEOHead from "../components/SEOHead.astro";
import StructuredData from "../components/StructuredData.astro";
import GoogleTagManager from "../components/GoogleTagManager.astro";
import Clarify from "../components/Clarify.astro";

// Props con valores por defecto mejorados
const {
  title = "MANPEG - Sistemas Contra Incendios en Medellín",
  description = "Servicios profesionales de inspección, pruebas y mantenimiento de sistemas contra incendios en Medellín y alrededores. Cumple con la normativa colombiana.",
  canonical = "https://manpeg.netlify.app/",
  ogImage = "https://manpeg.netlify.app/og-image.jpg",
  ogType = "website",
  pageType = "home",
} = Astro.props;
---

<html lang="es">
  <head>
    <Clarify />
    <GoogleTagManager />
    <!-- SEO Meta Tags Mejorados -->
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
    />

    <!-- Datos Estructurados JSON-LD -->
    <StructuredData type={pageType} />

    <!-- Estilos Globales y Router -->
    <GlobalStyles />
    <ClientRouter />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NNXQX8NC"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
