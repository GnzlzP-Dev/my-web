---
import "@fontsource-variable/montserrat";
---

<style is:global >
  * {
    body {
      font-family: "Montserrat Variable", sans-serif;
      /*padding: 80px;
      @media screen and (max-width: 768px) {
        padding: 40px;
        
      }
      @media screen and (max-width: 480px) {
        padding: 20px;
        
      }
      @media screen and (max-width: 320px) {
        padding: 10px;
        
      }*/
    }
    /* background-color: khaki; */
    /* color: #333; */
    margin: 0;
    padding: 0;
    box-sizing: border-box;

  }
  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  h2 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  h3 {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  h4 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  h5 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  h6 {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  p {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  a {
    text-decoration: none;
    color: #007bff;
  }
  ul {
    padding: 0 20px;
    list-style: square;
  }
  .nav-menu{
    display: flex;
    /* justify-content: center; */
    list-style-type: none;
    gap: 1rem;
  }

    .nav-menu a {
        text-decoration: none;
        color: #fff !important;
    }

  nav>ul>li {
    display: inline;
    margin-right: 1rem;
    background-color: #007bff;
  }

  button {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.25rem;
    background-color: #007bff;
    color: #fff;
    cursor: pointer;
  }
  button:hover {
    background-color: #0056b3;
  }
  input,
  textarea {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    padding: 0.5rem;
    border: 1px solid #ced4da;
    border-radius: 0.25rem;
    width: 100%;
    margin-bottom: 1rem;
  }
  label {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  .btn-post {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.25rem;
    background-color: #007bff;
    color: #fff;
    cursor: pointer;
  }
  .btn-post:hover {
    background-color: #0056b3;
  }
</style>
