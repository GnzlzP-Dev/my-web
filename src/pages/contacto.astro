---
import Layout from "../layouts/Layout.astro";

// SEO Props
const title = "Contáctanos - Cotiza Sistemas Contra Incendios en Medellín | MANPEG";
const description = "Solicita una cotización sin costo para inspección, pruebas y mantenimiento de sistemas contra incendios en Medellín. Atención rápida y profesional.";
const canonical = "https://manpeg.netlify.app/contacto";
const pageType = "contacto";
---

<Layout title={title} description={description} canonical={canonical} pageType={pageType}>
  <main class="bg-white text-gray-900 mt-[10vh]">
    <!-- Hero contacto -->
    <section class="bg-gray-100 py-16 px-6 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-bold mb-4">Contáctanos</h1>
        <p class="text-lg">
          Estamos listos para ayudarte con la inspección, pruebas y
          mantenimiento de tus sistemas contra incendios.
        </p>
      </div>
    </section>

    <!-- Sección contacto rápido -->
    <section
      class="py-16 px-6 max-w-5xl mx-auto grid md:grid-cols-3 gap-12 text-center">
      <div>
        <h2 class="text-xl font-semibold mb-2">📞 Teléfono</h2>
        <p class="text-lg">+57 304 317 93 49</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold mb-2">📧 Correo</h2>
        <p class="text-lg">servicios.manpeg@gmail.com</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold mb-2">💬 WhatsApp</h2>
        <a
          href="https://wa.me/573043179349"
          class="text-lg text-red-600 hover:underline">Escríbenos ahora</a
        >
      </div>
    </section>

    <!-- Formulario -->
    <section class="bg-gray-100 py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold mb-6 text-center">
          Solicita una cotización
        </h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          action="/gracias"
          class="space-y-6">
          <input type="hidden" name="form-name" value="contact" />

          <!-- Honeypot -->
          <p class="hidden">
            <label>No llenar si eres humano: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="nombre" class="block mb-1 font-medium"
              >Nombre completo</label
            >
            <input
              type="text"
              name="nombre"
              id="nombre"
              required
              class="w-full px-4 py-2 border rounded-lg"
            />
          </div>

          <div>
            <label for="email" class="block mb-1 font-medium"
              >Correo electrónico</label
            >
            <input
              type="email"
              name="email"
              id="email"
              required
              class="w-full px-4 py-2 border rounded-lg"
            />
          </div>

          <div>
            <label for="telefono" class="block mb-1 font-medium">Teléfono</label
            >
            <input
              type="tel"
              name="telefono"
              id="telefono"
              required
              class="w-full px-4 py-2 border rounded-lg"
            />
          </div>

          <div>
            <label for="mensaje" class="block mb-1 font-medium">Mensaje</label>
            <textarea
              name="mensaje"
              id="mensaje"
              rows="4"
              required
              class="w-full px-4 py-2 border rounded-lg"></textarea>
          </div>

          <button
            type="submit"
            class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-xl">
            Enviar
          </button>
        </form>
      </div>
    </section>

    <!-- Ubicación (opcional) -->
    <section class="py-16 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl font-bold mb-4">Ubicación</h2>
        <p class="mb-6">
          Estamos ubicados en Medellín, Antioquia. Atendemos toda el área
          metropolitana.
        </p>
        <div class="w-full h-80">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3976.7533557754173!2d-75.57935868467696!3d6.244338195483527!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e4429a3ae6c7c89%3A0x4eec4f5f8d75a18e!2sMedell%C3%ADn%2C%20Antioquia!5e0!3m2!1ses-419!2sco!4v1680123456789"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            title="Ubicación de MANPEG en Medellín, Antioquia"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>
</Layout>
